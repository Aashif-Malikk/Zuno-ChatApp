{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/app*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
, "src/app/index.jsx", "src/app/Splash.tsx", "src/app/(tabs)/Groups.jsx", "src/app/(tabs)/Search.jsx", "src/app/(tabs)/Profile.jsx", "src/app/Chat/[id].jsx", "src/app/(auth)/Login.tsx", "src/config/api.js"]
}