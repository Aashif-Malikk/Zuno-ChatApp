{
  "expo": {
    "name": "Zuno",
    "slug": "Zuno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../assets/Logo.png",
    "scheme": "zuno",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "../assets/Logo.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.Zuno"
    },
    "web": {
      "output": "static",
      "favicon": "../assets/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "../assets/Logo.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
